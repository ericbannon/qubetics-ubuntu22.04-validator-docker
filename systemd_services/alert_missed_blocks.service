# /etc/systemd/system/alert_missed_blocks.service
[Unit]
Description=Qubetics missed-blocks Telegram alerts (by-height scan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=RPC=http://127.0.0.1:26657
Environment=SCAN_RANGE=1000
Environment=CHECK_INTERVAL=30
Environment=INCLUDE_NIL=1
Environment=STATE_DIR=/var/lib/qubetics-alert
Environment=STATE_FILE=/var/lib/qubetics-alert/missed_byheight.state
Environment=SEEN_FILE=/var/lib/qubetics-alert/missed_seen.list
EnvironmentFile=/etc/default/telegram.env
ExecStart=/usr/bin/env bash -lc '/home/admin/scripts/alert_missed_blocks.sh'
Restart=always
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target